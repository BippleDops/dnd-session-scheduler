# Build-time variables for the Next.js static export (copy to apps/web/.env.local for local builds).

# Public origin of the deployed site; used for metadataBase / OpenGraph / JSON-LD URLs.
# Leave empty to omit absolute URLs from the metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Only needed when the API is served from a different origin than the web app.
# In `next dev` the /api and /auth paths are proxied to http://localhost:3000 instead (see next.config.ts).
NEXT_PUBLIC_API_URL=
