# Copy this to .env and fill in values
# cp env.example .env

# Server
PORT=3000
NODE_ENV=production
BASE_URL=https://dndsignup.get-suss.com
# REQUIRED in production — the server refuses to start without it. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-string
# Optional: separate secret for signed one-click email links (unsubscribe/RSVP). Defaults to SESSION_SECRET.
UNSUBSCRIBE_SECRET=
# Optional: max concurrent SSE streams per game session (default 50)
SSE_MAX_CLIENTS_PER_SESSION=50

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dndsignup.get-suss.com/auth/google/callback

# Admin emails (comma-separated)
ADMIN_EMAILS=your-email@gmail.com

# Email (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=D&D Session Scheduler <your-email@gmail.com>
# Set to 'true' to send emails. 'false' = log only (draft mode for testing).
EMAIL_AUTO_SEND=true

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# Google Calendar (optional, service account JSON path)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Data migration (one-time, from existing Google Sheet)
GOOGLE_SHEET_ID=
