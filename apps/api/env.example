# Copy this file:
#   - local development:  cp apps/api/env.example apps/api/.env   (dotenv loads it from the API's working directory)
#   - Docker deployments: cp apps/api/env.example .env             (docker-compose reads ./.env)

# Server
PORT=3000
NODE_ENV=production
# Public origin of the deployment. Used for links in emails, iCal UIDs and OAuth redirects.
BASE_URL=https://your-domain.example.com
# REQUIRED in production — the server refuses to start without it. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-string
# Optional: separate secret for signed one-click email links (unsubscribe/RSVP). Defaults to SESSION_SECRET.
UNSUBSCRIBE_SECRET=
# Optional: max concurrent SSE streams per game session (default 50)
SSE_MAX_CLIENTS_PER_SESSION=50
# Optional: SQLite file location (default apps/api/data/scheduler.db; login sessions live in it too, backups/ beside it)
# DB_PATH=/app/data/scheduler.db

# Scheduling
# IANA timezone for cron jobs, reminder windows and iCal TZID (default America/Chicago)
SCHEDULER_TIMEZONE=America/Chicago
# Campaigns seeded into a fresh database (comma-separated). Editable later via admin config (CAMPAIGN_LIST).
INITIAL_CAMPAIGNS=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example.com/auth/google/callback

# Admin emails (comma-separated)
ADMIN_EMAILS=your-email@gmail.com

# Email (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=D&D Session Scheduler <your-email@gmail.com>
# Set to 'true' to send emails. 'false' = log only (draft mode for testing).
EMAIL_AUTO_SEND=true

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# Google Calendar (optional, service account JSON path)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Data migration (one-time, from existing Google Sheet)
GOOGLE_SHEET_ID=

# ── docker-compose only ──
# Credentials for the sqlitebrowser container (required; no defaults)
SQLITE_BROWSER_USER=
SQLITE_BROWSER_PASS=
# Public origin baked into the web static export at build time (defaults to BASE_URL)
NEXT_PUBLIC_SITE_URL=
